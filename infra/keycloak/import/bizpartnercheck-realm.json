{
  "realm": "bizpartnercheck",
  "displayName": "BizPartnerCheck",
  "enabled": true,
  "sslRequired": "external",
  "loginTheme": "bizpartnercheck",
  "registrationAllowed": false,
  "registrationEmailAsUsername": true,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "rememberMe": false,
  "verifyEmail": false,
  "editUsernameAllowed": false,
  "passwordPolicy": "length(12) and maxLength(128) and notUsername(undefined) and notEmail(undefined) and passwordHistory(3)",
  "bruteForceProtected": true,
  "permanentLockout": false,
  "failureFactor": 5,
  "waitIncrementSeconds": 300,
  "maxFailureWaitSeconds": 900,
  "minimumQuickLoginWaitSeconds": 60,
  "quickLoginCheckMilliSeconds": 1000,
  "maxDeltaTimeSeconds": 43200,
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 36000,
  "actionTokenGeneratedByUserLifespan": 1800,
  "otpPolicyType": "totp",
  "otpPolicyAlgorithm": "HmacSHA1",
  "otpPolicyDigits": 6,
  "otpPolicyPeriod": 30,
  "otpPolicyLookAheadWindow": 1,
  "eventsEnabled": true,
  "eventsExpiration": 2592000,
  "eventsListeners": [
    "jboss-logging"
  ],
  "enabledEventTypes": [
    "LOGIN",
    "LOGIN_ERROR",
    "LOGOUT",
    "UPDATE_CREDENTIAL",
    "REMOVE_CREDENTIAL",
    "SEND_RESET_PASSWORD",
    "USER_DISABLED_BY_TEMPORARY_LOCKOUT",
    "USER_DISABLED_BY_PERMANENT_LOCKOUT"
  ],
  "adminEventsEnabled": true,
  "adminEventsDetailsEnabled": true,
  "internationalizationEnabled": true,
  "supportedLocales": [
    "en",
    "de"
  ],
  "defaultLocale": "en",
  "smtpServer": {
    "host": "mailpit",
    "port": "1025",
    "from": "no-reply@bizpartnercheck.local",
    "fromDisplayName": "BizPartnerCheck",
    "auth": "false",
    "ssl": "false",
    "starttls": "false"
  },
  "clients": [
    {
      "clientId": "bizpartnercheck-web",
      "name": "BizPartnerCheck web app",
      "description": "React web app. Public client: authorization code flow with PKCE.",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "frontchannelLogout": true,
      "rootUrl": "http://localhost:5173",
      "baseUrl": "/",
      "redirectUris": [
        "http://localhost:5173/*"
      ],
      "webOrigins": [
        "http://localhost:5173"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:5173/*"
      },
      "protocolMappers": [
        {
          "name": "api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.custom.audience": "bizpartnercheck-api",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "bizpartnercheck-api",
      "name": "BizPartnerCheck API",
      "description": "Service account of the backend: reads Keycloak's sign-in and admin events for the security log. Local development secret only.",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "bearerOnly": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "local-dev-only-change-in-production",
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "defaultClientScopes": [
        "basic",
        "roles",
        "kc-admin-api"
      ],
      "optionalClientScopes": []
    }
  ],
  "users": [
    {
      "username": "demo@bizpartnercheck.local",
      "email": "demo@bizpartnercheck.local",
      "emailVerified": true,
      "firstName": "Demo",
      "lastName": "User",
      "enabled": true,
      "realmRoles": [
        "default-roles-bizpartnercheck"
      ],
      "credentials": [
        {
          "type": "password",
          "value": "Demo-Password-2026",
          "temporary": false
        }
      ]
    },
    {
      "username": "admin@bizpartnercheck.local",
      "email": "admin@bizpartnercheck.local",
      "emailVerified": true,
      "firstName": "Demo",
      "lastName": "Admin",
      "enabled": true,
      "realmRoles": [
        "default-roles-bizpartnercheck",
        "org-admin",
        "platform-admin"
      ],
      "credentials": [
        {
          "type": "password",
          "value": "Admin-Password-2026",
          "temporary": false
        }
      ]
    },
    {
      "username": "service-account-bizpartnercheck-api",
      "enabled": true,
      "serviceAccountClientId": "bizpartnercheck-api",
      "clientRoles": {
        "realm-management": [
          "view-events",
          "view-users"
        ]
      }
    }
  ],
  "roles": {
    "realm": [
      {
        "name": "org-admin",
        "description": "Organisation admin: manages users, API tokens and settings of the own organisation; must use a second factor (S2.6)."
      },
      {
        "name": "platform-admin",
        "description": "Platform admin (operator of BizPartnerCheck, not a customer): data source imports such as the BMF list (S4.3)."
      }
    ]
  },
  "browserFlow": "browser with admin 2FA",
  "authenticationFlows": [
    {
      "alias": "browser with admin 2FA",
      "description": "Sign-in: password, then a one-time code. Required for org-admin, optional for everyone else (S2.6).",
      "providerId": "basic-flow",
      "topLevel": true,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "auth-cookie",
          "authenticatorFlow": false,
          "requirement": "ALTERNATIVE",
          "priority": 10,
          "userSetupAllowed": false
        },
        {
          "authenticator": "identity-provider-redirector",
          "authenticatorFlow": false,
          "requirement": "ALTERNATIVE",
          "priority": 20,
          "userSetupAllowed": false
        },
        {
          "authenticatorFlow": true,
          "requirement": "ALTERNATIVE",
          "priority": 30,
          "flowAlias": "admin 2FA forms",
          "userSetupAllowed": false
        }
      ]
    },
    {
      "alias": "admin 2FA forms",
      "description": "Password form followed by the second factor.",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "auth-username-password-form",
          "authenticatorFlow": false,
          "requirement": "REQUIRED",
          "priority": 10,
          "userSetupAllowed": false
        },
        {
          "authenticatorFlow": true,
          "requirement": "CONDITIONAL",
          "priority": 20,
          "flowAlias": "second factor for org admins",
          "userSetupAllowed": false
        },
        {
          "authenticatorFlow": true,
          "requirement": "CONDITIONAL",
          "priority": 30,
          "flowAlias": "second factor if set up",
          "userSetupAllowed": false
        }
      ]
    },
    {
      "alias": "second factor for org admins",
      "description": "Org admins must enter a one-time code; without an authenticator app they set one up first.",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "conditional-user-role",
          "authenticatorConfig": "user is org admin",
          "authenticatorFlow": false,
          "requirement": "REQUIRED",
          "priority": 10,
          "userSetupAllowed": false
        },
        {
          "authenticator": "auth-otp-form",
          "authenticatorFlow": false,
          "requirement": "REQUIRED",
          "priority": 20,
          "userSetupAllowed": false
        }
      ]
    },
    {
      "alias": "second factor if set up",
      "description": "Everyone else: one-time code only if they turned it on themselves.",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "conditional-user-role",
          "authenticatorConfig": "user is not org admin",
          "authenticatorFlow": false,
          "requirement": "REQUIRED",
          "priority": 10,
          "userSetupAllowed": false
        },
        {
          "authenticator": "conditional-user-configured",
          "authenticatorFlow": false,
          "requirement": "REQUIRED",
          "priority": 20,
          "userSetupAllowed": false
        },
        {
          "authenticator": "auth-otp-form",
          "authenticatorFlow": false,
          "requirement": "REQUIRED",
          "priority": 30,
          "userSetupAllowed": false
        }
      ]
    }
  ],
  "authenticatorConfig": [
    {
      "alias": "user is org admin",
      "config": {
        "condUserRole": "org-admin",
        "negate": "false"
      }
    },
    {
      "alias": "user is not org admin",
      "config": {
        "condUserRole": "org-admin",
        "negate": "true"
      }
    }
  ]
}
