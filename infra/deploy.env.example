# Deployment environment: staging or production
DOMAIN=staging.example.com

# PostgreSQL
POSTGRES_USER=bizpartner
POSTGRES_PASSWORD=REPLACE_WITH_SECURE_PASSWORD
POSTGRES_DB=bizpartner

# Backend database connection (same password as above)
DATABASE_URL=postgresql+psycopg://bizpartner:REPLACE_WITH_SECURE_PASSWORD@db:5432/bizpartner

# Keycloak authentication
OIDC_ISSUER=https://auth.example.com/realms/bizpartnercheck
OIDC_JWKS_URL=https://auth.example.com/realms/bizpartnercheck/protocol/openid-connect/certs
# Keycloak deployment
AUTH_DOMAIN=auth.example.com
KEYCLOAK_DB_PASSWORD=REPLACE_WITH_SECURE_KEYCLOAK_DB_PASSWORD
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=REPLACE_WITH_SECURE_ADMIN_PASSWORD