DATABASE_URL=postgresql+psycopg://bizpartner:bizpartner@localhost:5432/bizpartner

# Optional: another VIES server, e.g. a stub for staging (default: the EU Commission service)
# VIES_BASE_URL=https://ec.europa.eu/taxation_customs/vies/rest-api

# Sign-in (Keycloak). The defaults fit the local docker compose setup, so these are optional.
# OIDC_ISSUER=http://localhost:8080/realms/bizpartnercheck
# OIDC_AUDIENCE=bizpartnercheck-api
# Only if the API reaches Keycloak under another address than the browser (e.g. inside Docker):
# OIDC_JWKS_URL=http://keycloak:8080/realms/bizpartnercheck/protocol/openid-connect/certs

# Security log: the API reads Keycloak's sign-in events with this client (see docs/security-log.md).
# Locally the secret from the realm file is used automatically; on any server set your own.
# KEYCLOAK_API_CLIENT_ID=bizpartnercheck-api
# KEYCLOAK_API_CLIENT_SECRET=
# Only if the API reaches Keycloak under another address than OIDC_ISSUER (e.g. inside Docker):
# KEYCLOAK_API_BASE_URL=http://keycloak:8080/realms/bizpartnercheck
# How often Keycloak events are copied in the background, in seconds (0 = off)
# SECURITY_EVENTS_SYNC_SECONDS=300
