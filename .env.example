DATABASE_URL=postgresql+psycopg://bizpartner:bizpartner@localhost:5432/bizpartner

# Optional: another VIES server, e.g. a stub for staging (default: the EU Commission service)
# VIES_BASE_URL=https://ec.europa.eu/taxation_customs/vies/rest-api

# External sources (see docs/source-adapters.md). Fake answers without network, per source:
# VIES_ADAPTER=fake-ok   # or fake-finding, fake-timeout, fake-malformed; empty = real source
# BMF_ADAPTER=fake-ok
# HFU_ADAPTER=fake-ok
# ÖGK HFU list (see docs/hfu.md): the ÖGK test system instead of production
# HFU_BASE_URL=https://www.sozialversicherung.at/agh-ws-tt/DienstgeberAbfrageWS_3_0
# Time limits for all sources (defaults below); per source e.g. VIES_TIMEOUT_SECONDS=5
# SOURCE_TIMEOUT_SECONDS=8
# SOURCE_MAX_RETRIES=2
# SOURCE_DEADLINE_SECONDS=30

# Check runs (docs/check-runs.md): with a Redis queue, a Celery worker executes them.
# Leave it unset and the API runs checks itself (no worker needed). With it, start Redis
# (docker compose) and a worker: uv run celery -A app.worker worker --pool=threads --concurrency=4
# CELERY_BROKER_URL=redis://localhost:6379/0
# Time limit of a whole run in seconds (default 30)
# CHECK_RUN_DEADLINE_SECONDS=30

# Sign-in (Keycloak). The defaults fit the local docker compose setup, so these are optional.
# OIDC_ISSUER=http://localhost:8080/realms/bizpartnercheck
# OIDC_AUDIENCE=bizpartnercheck-api
# Only if the API reaches Keycloak under another address than the browser (e.g. inside Docker):
# OIDC_JWKS_URL=http://keycloak:8080/realms/bizpartnercheck/protocol/openid-connect/certs

# Security log: the API reads Keycloak's sign-in events with this client (see docs/security-log.md).
# Locally the secret from the realm file is used automatically; on any server set your own.
# KEYCLOAK_API_CLIENT_ID=bizpartnercheck-api
# KEYCLOAK_API_CLIENT_SECRET=
# Organization registration (docs/registration.md): dedicated Keycloak service account.
# Locally the secret from the realm file is used automatically; on any server set your own.
# KEYCLOAK_REGISTRATION_CLIENT_ID=bizpartnercheck-registration
# KEYCLOAK_REGISTRATION_CLIENT_SECRET=
# Address of the web app: the link in the registration e-mail leads back here.
# APP_BASE_URL=http://localhost:5173
# Only if the API reaches Keycloak under another address than OIDC_ISSUER (e.g. inside Docker):
# KEYCLOAK_API_BASE_URL=http://keycloak:8080/realms/bizpartnercheck
# How often Keycloak events are copied in the background, in seconds (0 = off)
# SECURITY_EVENTS_SYNC_SECONDS=300

# BMF list of fake companies (see docs/bmf.md): how often it is imported, in seconds (0 = off)
# BMF_IMPORT_INTERVAL_SECONDS=21600
# Another feed address, e.g. a saved copy for staging (default: the BMF feed)
# BMF_FEED_URL=https://service.bmf.gv.at/service/allg/lsu/rss_lsu.asp
